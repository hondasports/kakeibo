# Dependencies
node_modules
.pnpm-store/

# Build and test outputs
dist
coverage
playwright-report
test-results
dev-server-check.png
.playwright-browsers/

# Playwright auth state（認証情報を含むため git 管理外）
playwright/.clerk/

# Local environment and secrets
.env
.env.*
!.env.example
.npmrc
*.local
*.secret
*.secrets
*.key
*.pem
*.p12
*.pfx

# Service local state
.vercel/
# 外部インストールSkill等の環境依存生成物（手作りSkillは skills/ でGit管理）
.agents/

# Local script outputs
.tmp/

# Logs and OS files
*.log
.DS_Store

# indexion のローカル状態（digest index・reconcile DB等）。kgfs/ はプロジェクト固有スペックで共有対象
.indexion/*
!.indexion/kgfs/

# Convex anonymous/local deployment の state（e2e:isolated 等）
.convex/
