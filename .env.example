VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Convex Action から Clerk Backend API を呼ぶため、Convex Dashboard にも同じ値を設定する
# pnpm exec convex env set CLERK_SECRET_KEY sk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-frontend-api-url.clerk.accounts.dev
E2E_CLERK_USER_EMAIL=codex+clerk_test@example.com
E2E_CLERK_USER_PASSWORD=change-me

# Initial cloud project link. `pnpm run convex:dev` selects a local deployment
# and rewrites these values in the ignored `.env.local` file.
CONVEX_DEPLOYMENT=dev:your-deployment
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# E2E テストデータクリーンアップ用
# E2E_CLEANUP_SECRET は Convex Dashboard の同名環境変数と同じ値を設定する
# E2E_CLERK_USER_ID は Clerk Dashboard で確認したテストユーザーの tokenIdentifier
E2E_CLEANUP_SECRET=change-me
E2E_CLERK_USER_ID=https://your-clerk-frontend-api-url.clerk.accounts.dev|user_xxxxxx

# CONVEX_DEPLOY_KEY はローカルには設定しない
# PREVIEW RC: GitHub Environment Preview の Secret に Preview Deploy Key を設定する
# PROD: Production 環境構築時に Production Deploy Key を別途設定する
# Convex Dashboard > Project Settings > Generate Preview Deploy Key
# Convex Dashboard > Deployment Settings > Generate Production Deploy Key

# レシート画像抽出 (Convex 環境変数として設定する。.env.local には不要)
# pnpm exec convex env set RECEIPT_IMAGE_EXTRACTOR_MODE mock
# APP_ENV は全デプロイで必須（development / production の完全一致）。未設定だと mock 抽出などが拒否される
# pnpm exec convex env set APP_ENV development
# OPENAI_API_KEY は production deployment のみに設定する
# pnpm exec convex env set OPENAI_API_KEY sk-...

# トランザクションメール (Resend) (Convex 環境変数として設定する。.env.local には不要)
# pnpm exec convex env set APP_BASE_URL https://your-app-domain.com
# pnpm exec convex env set RESEND_API_KEY re_...
# pnpm exec convex env set RESEND_FROM_ADDRESS "Suzumemo <noreply@example.com>"
# pnpm exec convex env set RESEND_WEBHOOK_SECRET whsec_...
# APP_ENV が production 以外の場合、実メールは送信されずモック応答になる
