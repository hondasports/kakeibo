{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Suzumemo State Exit",
  "type": "object",
  "required": ["state", "event"],
  "properties": {
    "state": {
      "type": "string"
    },
    "event": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openFindings": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "resolution": {
      "type": "string",
      "minLength": 1
    },
    "reassessment": {
      "type": "string",
      "minLength": 1
    },
    "ciFailure": {
      "type": "object",
      "required": ["check"],
      "properties": {
        "check": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string"
        },
        "runUrl": {
          "type": ["string", "null"]
        },
        "artifactUrl": {
          "type": ["string", "null"]
        },
        "failedTests": {
          "type": "array"
        },
        "reproduce": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "reproduction": {
      "type": "object",
      "required": ["command", "result"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": ["reproduced", "not_reproduced"]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["source", "reference"],
      "properties": {
        "source": {
          "const": "user"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
