{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Suzumemo State Exit",
  "type": "object",
  "required": ["state", "event"],
  "properties": {
    "state": {
      "type": "string"
    },
    "event": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openFindings": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
