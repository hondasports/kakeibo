{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persistent Agent Task",
  "type": "object",
  "required": [
    "version",
    "taskId",
    "implementer",
    "state",
    "head",
    "baseRef",
    "baseHead",
    "branch",
    "risk",
    "attempt",
    "spec",
    "configuration",
    "skills",
    "verification",
    "counters",
    "history"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "implementer": {
      "type": "string",
      "minLength": 1
    },
    "head": {
      "type": "string",
      "minLength": 1
    },
    "baseRef": {
      "type": "string",
      "minLength": 1
    },
    "baseHead": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 2
    },
    "state": {
      "enum": ["refine", "execute", "review", "aftercare", "incident", "human_gate", "done"]
    },
    "risk": {
      "enum": ["T1", "T2", "T3"]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "spec": {
      "type": "object"
    },
    "configuration": {
      "type": "object",
      "required": ["profileSource", "profile", "selection", "runtime"],
      "properties": {
        "profileSource": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "object"
        },
        "selection": {
          "type": "object",
          "required": ["selected", "source", "ruleVersion"],
          "properties": {
            "selected": {
              "enum": ["fast", "standard", "deep", "max"]
            },
            "source": {
              "enum": ["provisional", "user", "auto"]
            },
            "ruleVersion": {}
          }
        },
        "runtime": {
          "type": "object"
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object"
    },
    "counters": {
      "type": "object",
      "required": ["review", "ci", "sameFailure"],
      "properties": {
        "review": {
          "type": "integer",
          "minimum": 0
        },
        "ci": {
          "type": "integer",
          "minimum": 0
        },
        "sameFailure": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assessment": {
      "type": ["object", "null"]
    },
    "agentAssessment": {
      "type": ["object", "null"]
    },
    "review": {
      "type": ["object", "null"]
    },
    "aftercare": {
      "type": ["object", "null"]
    },
    "lastFailure": {
      "type": ["object", "null"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
