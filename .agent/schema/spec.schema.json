{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Suzumemo Agent Spec",
  "type": "object",
  "required": [
    "goal",
    "acceptanceCriteria",
    "nonGoals",
    "assumptions",
    "openMaterialDecisions",
    "verificationStrategy",
    "predictedRisk"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nonGoals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openMaterialDecisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verificationStrategy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "predictedRisk": {
      "enum": ["T1", "T2", "T3"]
    }
  },
  "additionalProperties": false
}
