{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Suzumemo Agent Spec",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "goal",
        "acceptanceCriteria",
        "nonGoals",
        "assumptions",
        "openMaterialDecisions",
        "verificationStrategy",
        "predictedRisk"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "humanRequest": {
          "type": "string"
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "nonGoals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "openMaterialDecisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verificationStrategy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "predictedRisk": {
          "enum": ["T1", "T2", "T3"]
        },
        "prAllowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    {
      "title": "State-block spec reference (state-block/v2)",
      "type": "object",
      "required": ["ref", "fingerprint", "predictedRisk", "acIds", "openDecisions"],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "predictedRisk": {
          "enum": ["T1", "T2", "T3"]
        },
        "acIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "openDecisions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  ]
}
